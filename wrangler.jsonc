{
  // StudyAI Worker. No secret belongs in this file. Secrets are Cloudflare secrets (production) or .dev.vars (local, git-ignored):
  //   GEMINI_API_KEY, OWNER_KEY_HASH, SESSION_SECRET, ALLOWED_HOSTS
  // (ALLOWED_HOSTS is a secret only so that no hostname of yours is committed to a public repository.)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studyai",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-01",

  // Private first: the site is reachable on a *.workers.dev address, but the whole site (not just the API) answers only a
  // sign-in page until the owner signs in. When a custom domain is attached, set this to false. Preview URLs stay off.
  "workers_dev": true,
  "preview_urls": false,

  // run_worker_first=true sends EVERY request through the Worker so the private-site gate can check the owner's session
  // before a static file is served (code: worker/src/gate.ts, handleSite in app.ts). Do not change it to ["/api/*"] while
  // PRIVATE_SITE is "on": that would serve the files to anyone (a test checks this).
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },

  // One Durable Object (SQLite-backed, available on the free plan) holds the spend ledger, settings and login throttle.
  "durable_objects": { "bindings": [{ "name": "STUDYAI", "class_name": "StudyAiDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StudyAiDO"] }],

  "observability": { "enabled": true, "head_sampling_rate": 0.1 },

  // "on" = the whole site is private. Anything except "off" counts as on. "off" is only for a public copy of the app
  // (together with run_worker_first ["/api/*"]); the AI endpoints always need the owner either way.
  "vars": { "PRIVATE_SITE": "on" }
}
