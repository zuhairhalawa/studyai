{
  "name": "studyai",
  "private": true,
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/zuhairhalawa/studyai.git" },
  "bugs": { "url": "https://github.com/zuhairhalawa/studyai/issues" },
  "homepage": "https://github.com/zuhairhalawa/studyai#readme",
  "version": "0.1.0",
  "type": "module",
  "description": "Local-first AI-assisted university study platform (PPTX lectures, tutor, exams, flashcards).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "tsc -b --noEmit && pnpm typecheck:worker && vitest run && playwright test",
    "notices": "node scripts/third-party-notices.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "cli:build": "vite build -c vite.cli.config.ts",
    "types:worker": "wrangler types --strict-vars=false",
    "typecheck:worker": "pnpm types:worker && tsc -p tsconfig.worker.json",
    "owner:keygen": "node scripts/owner-keygen.mjs",
    "worker:dev": "pnpm build && wrangler dev"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "katex": "0.19.0",
    "lucide-react": "1.54.0",
    "minisearch": "7.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "rehype-highlight": "7.0.2",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "ts-fsrs": "5.4.2",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  }
}
