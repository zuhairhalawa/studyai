node_modules/
dist/
.wrangler/
coverage/
playwright-report/
test-results/
*.log

# Secrets: never commit. Worker secrets live in Cloudflare (wrangler secret) only.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# Private lecture material and study exports must never enter version control.
*.pptx
!tests/fixtures/**/*.pptx
*.studyai.zip
private/

# Local tool settings stay out of git, but the project skill is committed.
.claude/*
!.claude/skills/
.scratch/
dist-cli/

# TypeScript incremental build state
*.tsbuildinfo

# Keys, certificates and secret folders (see SECURITY.md)
*.pem
*.key
*.p12
secrets/

# Generated by `wrangler types` (large); regenerate with `pnpm types:worker`.
worker-configuration.d.ts

# Private test material (real course files, screenshots, reports): never committed
.private/
